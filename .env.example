# Variáveis de Ambiente - Risco Operacional

# ================== AMBIENTE ==================
# Opções: development, staging, production
ENVIRONMENT=development

# ================== LOGGING ==================
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ================== DADOS DE ENTRADA ==================
# Caminhos dos arquivos de origem (se não existirem localmente)
SOURCE_INCIDENTES=/mnt/data/incidentes_operacionais.csv
SOURCE_PERDAS=/mnt/data/perdas_mensais_por_area.csv

# ================== BANCO DE DADOS ==================
# URL do banco de dados (suporta SQLite e outros via SQLAlchemy)
# DATABASE_URL=sqlite:///dw/risk_dw.sqlite
# DATABASE_URL=postgresql://user:password@localhost/risco_operacional

# ================== FEATURES ==================
# Habilitar cache de resultados
ENABLE_CACHE=true

# TTL do cache em segundos
CACHE_TTL=3600
